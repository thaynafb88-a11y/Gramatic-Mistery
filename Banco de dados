### 📄 api/salvar.php
Salva o resultado de uma sessão e atualiza o ranking do aluno.

```php
<?php
require 'config.php';

$dados = json_decode(file_get_contents('php://input'), true);

$aluno_id     = $dados['aluno_id']      ?? null;
$categoria_id = $dados['categoria_id']  ?? null;
$modo         = $dados['modo']          ?? null;
$pontuacao    = $dados['pontuacao']     ?? 0;
$acertos      = $dados['acertos']       ?? 0;
$total        = $dados['total']         ?? 5;

if(!$aluno_id || !$categoria_id || !$modo){
    echo json_encode(['erro' => 'Dados incompletos']);
    exit;
}

// Salva a sessão no histórico
$stmt = $pdo->prepare("
    INSERT INTO sessoes
        (aluno_id, categoria_id, modo, pontuacao, acertos, total_questoes)
    VALUES (?, ?, ?, ?, ?, ?)
");
$stmt->execute([$aluno_id, $categoria_id, $modo, $pontuacao, $acertos, $total]);

// Atualiza o total de estrelas do aluno
$pdo->prepare("
    UPDATE alunos
    SET total_estrelas = total_estrelas + ?
    WHERE id = ?
")->execute([$pontuacao, $aluno_id]);

// Atualiza ou insere no ranking
$pdo->prepare("
    INSERT INTO ranking (aluno_id, total_estrelas)
    VALUES (?, ?)
    ON DUPLICATE KEY UPDATE
        total_estrelas = total_estrelas + VALUES(total_estrelas)
")->execute([$aluno_id, $pontuacao]);

echo json_encode(['sucesso' => true]);
```

