### 📄 api/login.php
Recebe email e senha, valida e retorna os dados do aluno ou professor.

```php
<?php
require 'config.php';

// Lê o JSON enviado pelo jogo
$dados = json_decode(file_get_contents('php://input'), true);

$email = $dados['email']  ?? '';
$senha = $dados['senha']  ?? '';
$tipo  = $dados['tipo']   ?? 'aluno'; // 'aluno' ou 'professor'

if(empty($email) || empty($senha)){
    echo json_encode(['erro' => 'Email e senha obrigatórios']);
    exit;
}

// Busca o usuário conforme o tipo
$tabela = $tipo === 'professor' ? 'professores' : 'alunos';
$stmt = $pdo->prepare("SELECT * FROM {$tabela} WHERE email = ?");
$stmt->execute([$email]);
$usuario = $stmt->fetch(PDO::FETCH_ASSOC);

// Verifica se existe e se a senha está correta
if(!$usuario || !password_verify($senha, $usuario['senha'])){
    echo json_encode(['erro' => 'Email ou senha incorretos']);
    exit;
}

// Remove a senha antes de retornar os dados
unset($usuario['senha']);

echo json_encode([
    'sucesso' => true,
    'tipo'    => $tipo,
    'usuario' => $usuario
]);
```

