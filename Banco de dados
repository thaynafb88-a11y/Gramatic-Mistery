## 🎮 PASSO 5 — Conectar o Jogo à API

No seu `script.js`, substitua os dados fixos por chamadas à API.

### Carregar categorias do banco
```javascript
// Substitui o objeto `categories` fixo
async function carregarCategorias(){
    const res  = await fetch('api/categorias.php');
    const data = await res.json();
    return data; // array de categorias do banco
}
```

### Carregar palavras de uma categoria
```javascript
async function carregarPalavras(categoriaId){
    const res  = await fetch(`api/palavras.php?categoria_id=${categoriaId}`);
    const data = await res.json();
    return data; // array de palavras com dicas
}
```

### Fazer login
```javascript
async function fazerLogin(email, senha, tipo = 'aluno'){
    const res = await fetch('api/login.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, senha, tipo })
    });
    const data = await res.json();
    if(data.sucesso) {
        playerName   = data.usuario.nome;
        playerAvatar = data.usuario.avatar;
        playerID     = data.usuario.id; // guarda o ID para salvar sessões
    }
    return data;
}
```

### Salvar resultado ao final de cada sessão
```javascript
async function salvarSessao(categoriaId, modo, pontuacao, acertos){
    await fetch('api/salvar.php', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            aluno_id:     playerID,
            categoria_id: categoriaId,
            modo,
            pontuacao,
            acertos,
            total: 5
        })
    });
}
```

### Carregar ranking do banco
```javascript
async function carregarRanking(){
    const res  = await fetch('api/ranking.php');
    const data = await res.json();
    // data é um array igual ao `ranking` que você já usa no jogo
    ranking = data;
    renderRanking();
}
```

